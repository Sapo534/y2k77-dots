{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "title": "white"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "separator",
    {
      "type": "os",
      "key": "  OS     |"
    },
    {
      "type": "kernel",
      "key": "  Kernel |"
    },
    {
      "type": "shell",
      "key": "  Shell  |"
    },
    {
      "type": "wm",
      "key": "󱂬 WM     |"
    },
    {
      "type": "cpu",
      "key": "  CPU    |"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU    |"
    },
    {
      "type": "memory",
      "key": "  RAM    |"
    },
    {
      "type": "disk",
      "key": "  Disk   |",
      "folders": "/"
    },
    "separator",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
